# URL publica de la aplicacion; vacia permite que PHP la detecte automaticamente.
APP_URL=
# Nombre de la base de datos creada por el contenedor MariaDB.
DB_NAME=dbstore
# Usuario de aplicacion que MariaDB crea con permisos sobre DB_NAME.
DB_USER=mvc
# Cambia este valor localmente antes de exponer el servicio.
DB_PASSWORD=mvc_dev_password
# Contrasena administrativa usada durante la inicializacion de MariaDB.
DB_ROOT_PASSWORD=mvc_root_password